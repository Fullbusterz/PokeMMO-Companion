# Online tournaments (Supabase). Copy this file to .env and fill both values in.
# Without them the app still works: the Swiss format runs fully offline and the
# "online tournament" option simply reports itself as unavailable.
#
# Where to find them: Supabase dashboard -> Project Settings -> API.
# EXPO_PUBLIC_* variables are inlined into the bundle at build time, so the anon
# key ships to every user. That is by design — it is the public key, and every
# table is behind RLS (see supabase/schema.sql). Never put the service_role key
# here; that one bypasses RLS entirely.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional. Only used to build the share link on native (on web the app reuses
# whatever origin it is served from). Defaults to the published web build.
EXPO_PUBLIC_APP_URL=https://fullbusterz.github.io/PokeMMO-Companion
